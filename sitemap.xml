---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}{{ site.baseurl }}/</loc></url>
  {% assign html_files = site.static_files | where_exp: "file", "file.extname == '.html'" %}
  {% for file in html_files %}
  <url><loc>{{ site.url }}{{ site.baseurl }}{{ file.path }}</loc></url>
  {% endfor %}
</urlset>
